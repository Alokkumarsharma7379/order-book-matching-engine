# Compose development credentials. Use a URL-safe value if overriding this password.
POSTGRES_PASSWORD=orderbook_dev
# Native persistent API (create the database and run alembic upgrade head first):
# DATABASE_URL=postgresql+psycopg://orderbook:orderbook_dev@127.0.0.1:5432/orderbook
# REDIS_URL=redis://127.0.0.1:6379/0
# Explicit nonpersistent local demo; never silently used as a database fallback:
# MEMORY_MODE=1
